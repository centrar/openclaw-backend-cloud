# ─────────────────────────────────────────────────────────────────────────────
# Goose OpenClaw MCP — environment variables
#
# Copy to .env and fill in real values. NEVER commit a real .env.
# All processes here load this via `dotenv` (path defaults to
# C:/Users/arvin/.openclaw/.env on the host, or ./.env in the Render service).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase connection (pooler). Used by server.js + goose_maintenance_bridge.cjs.
# IMPORTANT: this should be a connection string for a role scoped to ONLY the
# tables this app needs (tickets, knowledge_graph, quarantine_log,
# maintenance_tickets, pm2_telemetry, process_events). Do not reuse the
# dashboard/postgres role or grant broader schema access than required.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase REST client (used by hermes_render_api.js + supabase_sync_bridge.cjs).
# Use a SERVICE ROLE key here, NOT the anon/published key. The anon key must
# never be able to insert into quarantine_log (see supabase/migrations/0001).
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_KEY=<service_role_key>

# ── Kill-order HMAC (remote kill switch authentication) ──────────────────────
# SHARED secret between the Render API (signs) and the local bridge (verifies).
# Generate with:  openssl rand -hex 32
# If unset on either side, ALL kill orders are rejected (fail-closed).
KILL_ORDER_HMAC_SECRET=
# Max age of an accepted kill order, in ms. Orders older than this are rejected
# as stale (capture/replay defense). Default 300000 (5 min).
KILL_ORDER_MAX_AGE_MS=300000

# ── Bearer auth for the Render API (hermes_render_api.js) ────────────────────
# Distinct from SUPABASE_KEY — do NOT reuse. Used as the Authorization: Bearer
# token for POST /kill, GET /health, GET /quarantine.
RENDER_API_KEY=<generate_with_openssl_rand_hex_32>

# Port the Render Express API listens on.
PORT=3000

# Host identifier the local maintenance bridge claims tickets for.
# Must match the `host` column value the watchdog writes.
HOST=arvin-main
